{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cst:schema:project:v1",
  "title": "CST Project Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "$ref": "#/$defs/project" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "source", "toolDirectories", "requiredPorts", "tasks", "userActions", "settings"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 240 },
        "source": { "$ref": "#/$defs/source" },
        "toolDirectories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 3, "maxLength": 1024 }
        },
        "requiredPorts": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/port" }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/task" }
        },
        "userActions": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/action" }
        },
        "settings": { "$ref": "#/$defs/settings" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "branch", "workingDirectory", "gitExecutable", "credentialTarget"],
      "properties": {
        "repositoryUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "workingDirectory": { "type": "string", "minLength": 3, "maxLength": 1024 },
        "gitExecutable": { "type": "string", "minLength": 3, "maxLength": 1024 },
        "credentialTarget": { "type": "string", "pattern": "^CST/git/", "maxLength": 512 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "address", "port", "ownerTaskId"],
      "properties": {
        "protocol": { "enum": ["tcp", "udp"] },
        "address": { "type": "string", "minLength": 2, "maxLength": 45 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "ownerTaskId": { "$ref": "#/$defs/id" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inheritSystem", "envFiles", "variables"],
      "properties": {
        "inheritSystem": { "type": "boolean" },
        "envFiles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "variables": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": "string", "maxLength": 32767 }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "timeoutMs", "successExitCodes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "mode": { "enum": ["exec", "shell"] },
        "program": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 32767 }
        },
        "script": { "type": "string", "minLength": 1, "maxLength": 32767 },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "successExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "exec" } }, "required": ["mode"] },
          "then": { "required": ["program", "arguments"], "not": { "anyOf": [{ "required": ["script"] }] } }
        },
        {
          "if": { "properties": { "mode": { "const": "shell" } }, "required": ["mode"] },
          "then": { "required": ["script"], "not": { "anyOf": [{ "required": ["program"] }, { "required": ["arguments"] }] } }
        }
      ]
    },
    "tcpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "address", "port", "connectTimeoutMs"],
      "properties": {
        "type": { "const": "tcp" },
        "address": { "type": "string", "minLength": 2, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "connectTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    },
    "httpProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "expectedStatusCodes", "requestTimeoutMs"],
      "properties": {
        "type": { "const": "http" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
        "expectedStatusCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "requestTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "pollIntervalMs", "successThreshold", "probes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "pollIntervalMs": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "successThreshold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "oneOf": [{ "$ref": "#/$defs/tcpProbe" }, { "$ref": "#/$defs/httpProbe" }] }
        }
      }
    },
    "restartPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxRestarts", "windowSeconds", "backoffSeconds", "maxBackoffSeconds"],
      "properties": {
        "mode": { "const": "on_failure" },
        "maxRestarts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "windowSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "backoffSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxBackoffSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "workingDirectory", "environment", "prepareCommands", "serviceCommand", "readiness", "restartPolicy", "shutdownGraceMs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "order": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "environment": { "$ref": "#/$defs/environment" },
        "prepareCommands": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/command" }
        },
        "serviceCommand": { "$ref": "#/$defs/command" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "restartPolicy": { "$ref": "#/$defs/restartPolicy" },
        "shutdownGraceMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "type", "url", "availableWhen"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "order": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "type": { "const": "open_url" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048 },
        "availableWhen": { "enum": ["always", "running"] }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portReclaimTimeoutMs", "maxAncestorEscalation"],
      "properties": {
        "portReclaimTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "maxAncestorEscalation": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    }
  }
}
