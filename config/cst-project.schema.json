{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cst:schema:project:v1",
  "title": "CST Project Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "toolDirectories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "requiredPorts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "tasks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "userActions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "branch": {
          "type": "string",
          "maxLength": 255
        },
        "workingDirectory": {
          "type": "string",
          "maxLength": 1024
        },
        "gitExecutable": {
          "type": "string",
          "maxLength": 1024
        },
        "credentialTarget": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "address": {
          "type": "string",
          "maxLength": 45
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ownerTaskId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "inheritSystem": {
          "type": "boolean"
        },
        "envFiles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "variables": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 32767
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "exec",
            "shell"
          ]
        },
        "program": {
          "type": "string",
          "maxLength": 1024
        },
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 32767
          }
        },
        "script": {
          "type": "string",
          "maxLength": 32767
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "successExitCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "workingDirectory": {
          "type": "string",
          "maxLength": 1024
        },
        "activationScript": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "restartPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mode": {
          "const": "on_failure"
        },
        "maxRestarts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "backoffSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "maxBackoffSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "prepareCommands": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "serviceCommand": {
          "$ref": "#/$defs/command"
        },
        "restartPolicy": {
          "$ref": "#/$defs/restartPolicy"
        },
        "shutdownGraceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "type": {
          "const": "open_url"
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "availableWhen": {
          "enum": [
            "always",
            "running"
          ]
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "portReclaimTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "maxAncestorEscalation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    }
  }
}
